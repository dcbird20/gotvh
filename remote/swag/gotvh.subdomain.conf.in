# GoTVH away from home: the admin app and Tvheadend's API/streams for paired devices.
# Made by remote/install-swag-site.sh from this template; lives in SWAG's
# /config/nginx/proxy-confs/. Delete it (and reload SWAG) to switch the web side off.
#
# Uses GoTVH's own wildcard certificate (*.__BASE_DOMAIN__), so SWAG's certificate for the base
# name — and everything else SWAG serves — is untouched.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __TV_HOST__;

    ssl_certificate     /config/gotvh/certs/fullchain.pem;
    ssl_certificate_key /config/gotvh/certs/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Paired devices only: a certificate from the GoTVH pairing service...
    ssl_client_certificate /config/gotvh/pki/ca.pem;
    ssl_verify_client on;
    # ...without one, hang up without a word.
    error_page 495 496 = @gotvh_refuse;
    location @gotvh_refuse { return 444; }

    # Pairing happens at home only.
    location /pair/ { return 404; }

    # ...and not removed since (asked on every request, so removal takes effect at once).
    location = /gotvh-device-check {
        internal;
        proxy_pass http://__PAIR__/pair/api/check?serial=$ssl_client_serial;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    location / {
        auth_request /gotvh-device-check;
        error_page 401 403 = @gotvh_refuse;

        proxy_pass http://__HOME_WEB__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Live streams and long polls: no buffering, no early cut-off.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 50m;
    }
}
