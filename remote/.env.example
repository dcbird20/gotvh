# Copy to .env and fill in. .env is not committed (it holds your DNS provider's API key).

# A name under your own domain just for this, e.g. tv.example.com. You'll add one DNS record:
#   *.tv.example.com   A   <your Xfinity address>
BASE_DOMAIN=tv.example.com

# The two names the apps use away from home: random labels under BASE_DOMAIN, so nobody can
# guess them; anything else that knocks is hung up on. Make them with:
#   echo tv-$(openssl rand -hex 4); echo htsp-$(openssl rand -hex 4)
TV_HOST=tv-xxxxxxxx.tv.example.com
HTSP_HOST=htsp-xxxxxxxx.tv.example.com

# Your DNS provider's acme.sh plugin and its API credentials, so Let's Encrypt can check you own
# the domain. List: https://github.com/acmesh-official/acme.sh/wiki/dnsapi  Examples:
#   Cloudflare:  ACME_DNS=dns_cf         CF_Token=...  (API token with Zone:DNS:Edit)
#   Namecheap:   ACME_DNS=dns_namecheap  NAMECHEAP_USERNAME=...  NAMECHEAP_API_KEY=...  NAMECHEAP_SOURCEIP=...
#   GoDaddy:     ACME_DNS=dns_gd         GD_Key=...  GD_Secret=...
#   Porkbun:     ACME_DNS=dns_porkbun    PORKBUN_API_KEY=...  PORKBUN_SECRET_API_KEY=...
ACME_DNS=
# (credentials go here)

# raven1's home-network address: the pairing service listens only there.
PAIR_LAN_IP=192.168.1.72

# Optional address updater (docker compose --profile ddns up -d): put a ddclient.conf for your
# provider in remote/ddclient/ (see https://ddclient.net). Xfinity addresses rarely change.
