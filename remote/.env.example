# Copy to .env and fill in. .env is not committed (it holds your DuckDNS token).

# SWAG's config folder on raven1 (the host side of its /config volume).
SWAG_DIR=/opt/swag

# GoTVH gets its own certificate for *.BASE_DOMAIN. With DuckDNS that's your DuckDNS name;
# every name under it already points home, so no DNS records to add.
BASE_DOMAIN=magnumpi.duckdns.org

# The two names the apps use away from home: random labels under BASE_DOMAIN, so nobody can
# guess them; anything else that knocks is hung up on. Make them with:
#   echo tv-$(openssl rand -hex 4); echo htsp-$(openssl rand -hex 4)
TV_HOST=tv-xxxxxxxx.magnumpi.duckdns.org
HTSP_HOST=htsp-xxxxxxxx.magnumpi.duckdns.org

# How Let's Encrypt checks you own the name: through your DNS provider (acme.sh plugin).
# DuckDNS: the same token as SWAG's DUCKDNSTOKEN.
ACME_DNS=dns_duckdns
DuckDNS_Token=
# DuckDNS answers slowly; give the check time.
ACME_DNSSLEEP=120

# raven1's home-network address: the pairing service listens only there; SWAG reaches it, and
# raven1's nginx (admin app, Tvheadend) on port 8090, at this address.
PAIR_LAN_IP=192.168.1.72
