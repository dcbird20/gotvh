# Copy to .env and fill in. .env is not committed (it holds your DuckDNS token).

# Your DuckDNS name (the part before .duckdns.org) and its token, from duckdns.org.
# Pick something that doesn't identify you, e.g. "quietfox7731".
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# The two addresses the apps use away from home. Random-looking labels mean nobody can guess
# them; anything else that knocks is hung up on. Generate with:  echo tv-$(openssl rand -hex 4)
TV_HOST=tv-xxxxxxxx.yourname.duckdns.org
HTSP_HOST=htsp-xxxxxxxx.yourname.duckdns.org

# raven1's home-network address: the pairing service listens only there.
PAIR_LAN_IP=192.168.1.72
