# GoTVH front door for live TV (HTSP) — the web side goes through SWAG (see swag/).
#
# One port (8443 outside and in). The first bytes of each connection name the host it wants
# (TLS SNI):
#   __HTSP_HOST__  TLS with a device certificate → Tvheadend's HTSP port (live TV with pause)
#   anything else  closed at once, before any handshake (scanners find nothing)
# A removed device is refused (revocation list from the pairing service; reloaded by start.sh).

worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

stream {
    log_format route '$proxy_protocol_addr $ssl_client_s_dn $status $bytes_sent $session_time';

    map $ssl_preread_server_name $gotvh_route {
        __HTSP_HOST__  127.0.0.1:8445;
        default        127.0.0.1:1;
    }

    server {
        listen 8443;
        ssl_preread on;
        proxy_pass $gotvh_route;
        proxy_protocol on;          # pass the visitor's address on, for the log
        proxy_connect_timeout 2s;
    }

    server {
        listen 127.0.0.1:8445 ssl proxy_protocol;
        access_log /dev/stdout route;

        ssl_certificate     /certs/fullchain.pem;
        ssl_certificate_key /certs/key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:htsp_tls:1m;
        ssl_client_certificate /pki/ca.pem;
        ssl_verify_client on;
        ssl_crl /pki/crl.pem;

        proxy_pass __TVH_HTSP__;
        proxy_timeout 12h;          # live TV and long pauses
    }
}
